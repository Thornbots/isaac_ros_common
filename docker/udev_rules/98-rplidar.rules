# set the udev rule , make the device_port be fixed by rplidar
# combined from 99-realsense-libusb-custom.rules from isaac ros realsense example https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_common
# and sllidar_ros2 https://github.com/Slamtec/sllidar_ros2 

ACTION=="add", SUBSYSTEMS=="usb", KERNEL=="ttyUSB*", \
  ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", \
  MODE:="0666", GROUP:="plugdev", \
  SYMLINK+="rplidar", \
  RUN+="/opt/rplidar/hotplug-rplidar.sh -a add -d '%E{DEVNAME}' -M '%M' -m '%m'"

ACTION=="remove", SUBSYSTEMS=="usb", KERNEL=="ttyUSB*", \
  ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", \
  RUN+="/opt/rplidar/hotplug-rplidar.sh -a remove -d '%E{DEVNAME}'"

