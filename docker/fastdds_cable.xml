<?xml version="1.0" encoding="UTF-8"?>
<!--
  Discovery-server client profile: tailscale0 has no usable multicast, so
  cross-machine discovery goes through a server the publisher starts by hand
  (scripts/dds_server.sh). Nothing discovers anything until it runs.

  profile_name MUST be "participant_profile" (rmw_fastrtps looks it up by that
  exact name; is_default_profile is not enough). Server prefixes below encode
  the server id: `-i 0` yields 44.53.00.5f...; change the id, change the prefix.
  Server and clients must share a ROS_DOMAIN_ID.
  See the isaac-ros-docker skill's reference.md for why there is no
  <useBuiltinTransports>false</useBuiltinTransports> or <interfaceWhiteList>.
-->
<profiles xmlns="http://eprosima.com" schemaLocation="http://eprosima.com http://com.xsd">
  <participant profile_name="participant_profile" is_default_profile="true">
    <rtps>
      <builtin>
        <discovery_config>
          <!-- SUPER_CLIENT, not CLIENT: a plain client only learns the
               endpoints it matches, so `ros2 topic list`/`hz`/rviz show an empty
               graph and it reads exactly like broken discovery. -->
          <discoveryProtocol>SUPER_CLIENT</discoveryProtocol>
          <discoveryServersList>
            <!-- ts-nano-standard, started with `-i 0` -->
            <RemoteServer prefix="44.53.00.5f.45.50.52.4f.53.49.4d.41">
              <metatrafficUnicastLocatorList>
                <locator>
                  <udpv4>
                    <address>100.93.23.77</address>
                    <port>11811</port>
                  </udpv4>
                </locator>
              </metatrafficUnicastLocatorList>
            </RemoteServer>
            <!-- ts-nano-hero, started with `-i 1` -->
            <RemoteServer prefix="44.53.01.5f.45.50.52.4f.53.49.4d.41">
              <metatrafficUnicastLocatorList>
                <locator>
                  <udpv4>
                    <address>100.89.195.53</address>
                    <port>11811</port>
                  </udpv4>
                </locator>
              </metatrafficUnicastLocatorList>
            </RemoteServer>
            <!-- ts-nano-sentry, started with `-i 2` -->
            <RemoteServer prefix="44.53.02.5f.45.50.52.4f.53.49.4d.41">
              <metatrafficUnicastLocatorList>
                <locator>
                  <udpv4>
                    <address>100.87.215.118</address>
                    <port>11811</port>
                  </udpv4>
                </locator>
              </metatrafficUnicastLocatorList>
            </RemoteServer>
          </discoveryServersList>
        </discovery_config>
      </builtin>
    </rtps>
  </participant>
</profiles>
