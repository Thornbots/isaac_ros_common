##############################################################################
# Dockerfile.thornbots — Thornbots top layer over Isaac ROS.
#
# Context is isaac_ros-dev/src/ (run_dev.sh passes --context_dir), so every
# COPY path is relative to src/. Our packages come from the checked-out git
# submodules, never a clone during the build. See README.md.
##############################################################################

ARG BASE_IMAGE=nvcr.io/nvidia/isaac/ros:humble-3.2
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]
# Entrypoint patch: put the container user in `dialout` for serial devices.
RUN sed -i 's/adduser \${USERNAME} sudo  >\/dev\/null/adduser \${USERNAME} sudo  >\/dev\/null\ngroupadd -f dialout >\/dev\/null\nadduser \${USERNAME} dialout >\/dev\/null/' \
    /usr/local/bin/scripts/workspace-entrypoint.sh

# Capped so the Jetson/build host doesn't OOM: -j6 compiler jobs,
# 3 concurrent packages. --symlink-install keeps sources live-editable.
ENV MAKEFLAGS="-j6"
ENV COLCON_OPTS="--symlink-install \
    --parallel-workers 3 \
    --cmake-args -DCMAKE_BUILD_TYPE=Release \
    --event-handlers console_direct+"

ENV ROS_WS=/workspaces/ros2_ws
ENV ROS_SETUP=/opt/ros/humble/setup.bash

##############################################################################
# LAYER 1 — System build tools
##############################################################################
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    python3-colcon-common-extensions \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

##############################################################################
# LAYER 2 — Isaac ROS binary packages
##############################################################################
# Yarn repo: copied from another section to avoid a docker build error.
RUN curl -sS https://dl.yarnpkg.com/debian/pubkey.gpg | apt-key add - && \
    echo "deb https://dl.yarnpkg.com/debian/ stable main" > /etc/apt/sources.list.d/yarn.list && \
    apt-get update && apt-get install -y yarn && \
    corepack enable

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-isaac-ros-yolov8 \
    ros-humble-isaac-ros-dnn-image-encoder \
    ros-humble-isaac-ros-tensor-rt \
    ros-humble-isaac-ros-examples \
    ros-humble-isaac-ros-realsense \
    ros-humble-isaac-ros-common \
    ros-humble-image-transport-plugins \
    && rm -rf /var/lib/apt/lists/*

##############################################################################
# LAYER 2b — Gazebo / ros_gz, for `sim` only. Off by default: real hardware
# never launches gz-sim. To run `sim` in a container from this image:
#   sudo isaac_ros_common/docker/scripts/install-sim.sh
##############################################################################
# RUN apt-get update && apt-get install -y --no-install-recommends \
#     ros-humble-ros-gz \
#     && rm -rf /var/lib/apt/lists/*

##############################################################################
# LAYER 3 — RealSense config patches (60 fps profiles)
##############################################################################
COPY isaac_ros_common/docker/config/realsense_mono_depth_60fps.yaml \
    /opt/ros/humble/share/isaac_ros_realsense/config/realsense_mono_depth.yaml

COPY isaac_ros_common/docker/config/realsense_mono_60fps.yaml \
    /opt/ros/humble/share/isaac_ros_realsense/config/realsense_mono.yaml

##############################################################################
# LAYER 4 — dependencies, resolved by rosdep from the manifests
#
# Manifests only, so this layer survives source edits. rosdep derives the dep
# set from package.xml instead of a hand-kept apt list that silently drifts.
# --skip-keys and the version floor are load-bearing; see README.md.
##############################################################################
COPY sllidar_ros2/package.xml                   ${ROS_WS}/src/sllidar_ros2/package.xml
COPY ros2_dji_serial_bridge/package.xml         ${ROS_WS}/src/ros2_dji_serial_bridge/package.xml
COPY Realsense_ROI_Depth_Rectifier/package.xml  ${ROS_WS}/src/Realsense_ROI_Depth_Rectifier/package.xml
COPY rf2o_laser_odometry/package.xml            ${ROS_WS}/src/rf2o_laser_odometry/package.xml
COPY sentry_localization/package.xml            ${ROS_WS}/src/sentry_localization/package.xml
COPY thornbots_pkg/package.xml                  ${ROS_WS}/src/thornbots_pkg/package.xml
COPY realsense-yolov8-nitros-bridge/package.xml ${ROS_WS}/src/realsense-yolov8-nitros-bridge/package.xml
RUN source ${ROS_SETUP} && \
    apt-get update && \
    rosdep install -y --from-paths ${ROS_WS}/src --ignore-src --rosdistro humble \
        --skip-keys "realsense2_camera realsense2_camera_msgs" && \
    apt-get satisfy -y --no-install-recommends \
    "ros-humble-diagnostic-updater (>= 4.0.7)" \
    && rm -rf /var/lib/apt/lists/*

##############################################################################
# LAYER 5 — our packages: submodules in, one colcon build out.
#
# One COPY per directory (a multi-source COPY flattens them, and copying the
# whole context would drag in `sim`). Directory name != package name for
# three of them, hence the explicit --packages-select list.
##############################################################################
COPY sllidar_ros2                   ${ROS_WS}/src/sllidar_ros2
COPY ros2_dji_serial_bridge         ${ROS_WS}/src/ros2_dji_serial_bridge
COPY Realsense_ROI_Depth_Rectifier  ${ROS_WS}/src/Realsense_ROI_Depth_Rectifier
COPY rf2o_laser_odometry            ${ROS_WS}/src/rf2o_laser_odometry
COPY sentry_localization            ${ROS_WS}/src/sentry_localization
COPY thornbots_pkg                  ${ROS_WS}/src/thornbots_pkg
COPY realsense-yolov8-nitros-bridge ${ROS_WS}/src/realsense-yolov8-nitros-bridge
RUN cd ${ROS_WS} && \
    source ${ROS_SETUP} && \
    colcon build ${COLCON_OPTS} --packages-select \
        sllidar_ros2 \
        dji_serial_bridge \
        roi_depth_query \
        rf2o_laser_odometry \
        sentry_localization \
        thornbots_pkg \
        realsense_yolov8_nitros_bridge

##############################################################################
# LAYER 6 — Environment + DDS profile
##############################################################################
ARG ROS_DOMAIN_ID=0
RUN echo "export ROS_DOMAIN_ID=${ROS_DOMAIN_ID}" >> /etc/bash.bashrc && \
    echo "export FASTRTPS_DEFAULT_PROFILES_FILE=/etc/fastdds/profile.xml"  >> /etc/bash.bashrc && \
    echo "export RMW_IMPLEMENTATION=rmw_fastrtps_cpp"  >> /etc/bash.bashrc
RUN echo "source ${ROS_SETUP}" >> /etc/bash.bashrc && \
    echo "source ${ROS_WS}/install/setup.bash" >> /etc/bash.bashrc
# Sends connections to devices over usbc cable
COPY isaac_ros_common/docker/fastdds_cable.xml /etc/fastdds/profile.xml
# sllidar udev rules — unnecessary now that the user is in `dialout`.
#RUN source ${ROS_WS}/src/sllidar_ros2/scripts/create_udev_rules.sh

WORKDIR ${ROS_WS}
CMD ["/bin/bash"]
