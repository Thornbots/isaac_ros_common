ARG BASE_IMAGE=nvcr.io/nvidia/isaac/ros:humble-3.2
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]
ARG SLLIDAR_GIT_URL=https://github.com/Thornbots/sllidar_ros2.git


# -----------------------------
# System dependencies
# -----------------------------
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    python3-colcon-common-extensions \
    python3-pip 

# -----------------------------
# Isaac ROS packages
# -----------------------------
RUN apt-get update && apt-get install -y \
    ros-humble-isaac-ros-yolov8 \
    ros-humble-isaac-ros-dnn-image-encoder \
    ros-humble-isaac-ros-tensor-rt \
    ros-humble-isaac-ros-examples \
    ros-humble-isaac-ros-realsense \
    ros-humble-isaac-ros-common \
    ros-humble-image-transport-plugins

# -----------------------------
# Patch Realsense configs
# -----------------------------
COPY config/realsense_mono_depth_60fps.yaml \
    /opt/ros/humble/share/isaac_ros_realsense/config/realsense_mono_depth.yaml

COPY config/realsense_mono_60fps.yaml \
    /opt/ros/humble/share/isaac_ros_realsense/config/realsense_mono.yaml

# -----------------------------
# Create ROS workspace
# -----------------------------
WORKDIR /workspaces/ros2_ws/src


# Clone dependencies
#  YOLO26 TensorRT 
ARG RECLONE_YOLO=1
RUN git clone -b jetson-buildfix https://github.com/BrooklynLJ/ROS2-Yolo26-TensorRT.git

#Lidar package
ARG RECLONE_SLLIDAR=1
RUN git clone ${SLLIDAR_GIT_URL}

#Serial package
ARG RECLONE_SERIAL=1
RUN git clone -b dji_implimentation https://github.com/BrooklynLJ/ros2_dji_serial.git
#RUN git clone https://github.com/BrooklynLJ/ros2_dji_serial.git

#Depth computation package
ARG RECLONE_DEPTH=2
RUN git clone https://github.com/Thornbots/Realsense_ROI_Depth_Rectifier.git

# -----------------------------
# Build workspace 
# -----------------------------
WORKDIR /workspaces/ros2_ws/

# Restrict the underlying 'make' to only use 2 CPU threads at a time, otherwise can freak out 
# and use all system resources
ENV MAKEFLAGS="-j4"
RUN source /opt/ros/humble/setup.bash && \
    colcon build --symlink-install \   
        --parallel-workers 3 \
        --cmake-args -DCMAKE_BUILD_TYPE=Release 

# -----------------------------
# Environment setup
# -----------------------------
RUN echo "source /opt/ros/humble/setup.bash" >> /etc/bash.bashrc && \
    echo "source /workspaces/ros2_ws/install/setup.bash" >> /etc/bash.bashrc

# -----------------------------
# Environment setup to add udev rules
# -----------------------------
WORKDIR /workspaces/ros2_ws/src/sllidar_ros2

RUN source scripts/create_udev_rules.sh

CMD ["/bin/bash"]