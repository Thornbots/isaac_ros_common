ARG BASE_IMAGE=nvcr.io/nvidia/isaac/ros:humble-3.2
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]

ARG SLLIDAR_GIT_URL=https://github.com/Thornbots/sllidar_ros2.git

# -----------------------------
# System dependencies
# -----------------------------
RUN apt-get update && apt-get install -y \
    git \
    build-essential \
    python3-colcon-common-extensions \
    python3-pip 

# -----------------------------
# Isaac ROS packages
# -----------------------------
RUN apt-get update && apt-get install -y \
    ros-humble-isaac-ros-yolov8 \
    ros-humble-isaac-ros-dnn-image-encoder \
    ros-humble-isaac-ros-tensor-rt \
    ros-humble-isaac-ros-examples \
    ros-humble-isaac-ros-realsense \
    ros-humble-isaac-ros-common

# -----------------------------
# Patch Realsense configs
# -----------------------------
COPY config/realsense_mono_depth_60fps.yaml \
    /opt/ros/humble/share/isaac_ros_realsense/config/realsense_mono_depth.yaml

COPY config/realsense_mono_60fps.yaml \
    /opt/ros/humble/share/isaac_ros_realsense/config/realsense_mono.yaml

# -----------------------------
# Create ROS workspace
# -----------------------------
WORKDIR /workspaces/ros2_ws/src

# Clone dependencies
RUN git clone ${SLLIDAR_GIT_URL}

# 🔥 YOLO26 TensorRT repo (important part)
RUN git clone -b trt10-aphid https://github.com/BrooklynLJ/ROS2-Yolo26-TensorRT.git

# -----------------------------
# Build workspace (critical ordering)
# -----------------------------
WORKDIR /workspaces/ros2_ws/

RUN source /opt/ros/humble/setup.bash && \
    colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release

# -----------------------------
# Environment setup
# -----------------------------
RUN echo "source /opt/ros/humble/setup.bash" >> /etc/bash.bashrc && \
    echo "source /workspaces/ros2_ws/install/setup.bash" >> /etc/bash.bashrc

CMD ["/bin/bash"]