# syntax=docker/dockerfile:1.7-labs
##############################################################################
# Dockerfile.thornbots: Thornbots top layer over Isaac ROS 4.6 (Jazzy).
#
# isaac-ros-cli builds it as isaac_ros -> realsense -> thornbots. Context is
# isaac_ros-dev/src/ (context_overrides in scripts/.build_image_layers.yaml),
# so every COPY path is relative to src/. Sources come from the checked-out
# submodules. 1.7-labs is for COPY --parents/--exclude. See README.md.
##############################################################################

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]

# Capped so the Jetson/build host doesn't OOM: -j6 compiler jobs,
# 3 concurrent packages. --symlink-install keeps sources live-editable.
ENV MAKEFLAGS="-j6"
ENV COLCON_OPTS="--symlink-install \
    --parallel-workers 3 \
    --cmake-args -DCMAKE_BUILD_TYPE=Release \
    --event-handlers console_direct+"

ENV ROS_WS=/workspaces/ros2_ws
ENV ROS_SETUP=/opt/ros/jazzy/setup.bash

##############################################################################
# LAYER 1: build tools and the Isaac ROS binary packages
##############################################################################
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    python3-colcon-common-extensions \
    python3-pip \
    ros-jazzy-isaac-ros-yolov8 \
    ros-jazzy-isaac-ros-dnn-image-encoder \
    ros-jazzy-isaac-ros-tensor-rt \
    ros-jazzy-isaac-ros-examples \
    ros-jazzy-isaac-ros-realsense \
    ros-jazzy-isaac-ros-common \
    ros-jazzy-image-transport-plugins \
    ros-jazzy-foxglove-bridge \
    && rm -rf /var/lib/apt/lists/*

# gz-sim is not installed: real hardware never launches it. For `sim`, run
# isaac_ros_common/docker/scripts/install-sim.sh in the container.

##############################################################################
# LAYER 2: dependencies, resolved by rosdep from the manifests
#
# Manifests only, so this layer survives source edits. --skip-keys is
# load-bearing; see README.md.
##############################################################################
COPY --parents */package.xml ${ROS_WS}/src/
RUN source ${ROS_SETUP} && \
    apt-get update && \
    rosdep install -y --from-paths ${ROS_WS}/src --ignore-src --rosdistro jazzy \
        --skip-keys "realsense2_camera realsense2_camera_msgs" \
    && rm -rf /var/lib/apt/lists/*

##############################################################################
# LAYER 3: our packages, one COPY and one colcon build.
#
# .dockerignore already drops sim/ and all of isaac_ros_common but docker/.
# Directory name != package name for three of them, hence the explicit list.
##############################################################################
COPY --exclude=isaac_ros_common --exclude=*.md --exclude=.dockerignore . ${ROS_WS}/src/
RUN cd ${ROS_WS} && \
    source ${ROS_SETUP} && \
    colcon build ${COLCON_OPTS} --packages-select \
        sllidar_ros2 \
        dji_serial_bridge \
        roi_depth_query \
        rf2o_laser_odometry \
        sentry_localization \
        thornbots_pkg \
        realsense_yolov8_nitros_bridge

##############################################################################
# LAYER 4: config files, entrypoint addition, shell environment
#
# RealSense 60 fps profiles over the stock ones, the DDS profile, the
# rplidar udev rule, and `dialout` for the container user (serial devices).
# ROS_DOMAIN_ID is 1 until the Jazzy cutover (JAZZY_FLASH.md).
##############################################################################
COPY isaac_ros_common/docker /opt/thornbots/docker
ARG ROS_DOMAIN_ID=1
RUN D=/opt/thornbots/docker && \
    RS=/opt/ros/jazzy/share/isaac_ros_realsense/config && \
    cp ${D}/config/realsense_mono_60fps.yaml ${RS}/realsense_mono.yaml && \
    cp ${D}/config/realsense_mono_depth_60fps.yaml ${RS}/realsense_mono_depth.yaml && \
    install -D -m 644 ${D}/fastdds_cable.xml /etc/fastdds/profile.xml && \
    install -D -m 644 ${D}/udev_rules/98-rplidar.rules /etc/udev/rules.d/98-rplidar.rules && \
    install -D -m 755 ${D}/scripts/hotplug-rplidar.sh /opt/rplidar/hotplug-rplidar.sh && \
    install -D -m 755 ${D}/scripts/entrypoint_additions/50-dialout.sh \
        /usr/local/bin/scripts/entrypoint_additions/50-dialout.sh && \
    { echo "export ROS_DOMAIN_ID=${ROS_DOMAIN_ID}"; \
      echo "export FASTRTPS_DEFAULT_PROFILES_FILE=/etc/fastdds/profile.xml"; \
      echo "export RMW_IMPLEMENTATION=rmw_fastrtps_cpp"; \
      echo "source ${ROS_SETUP}"; \
      echo "source ${ROS_WS}/install/setup.bash"; } >> /etc/bash.bashrc

WORKDIR ${ROS_WS}
CMD ["/bin/bash"]
