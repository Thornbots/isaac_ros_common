##############################################################################
# Dockerfile.thornbots
#
# Each git-cloned package gets its OWN layer: clone → build → install.
# Changing one package (or bumping its RECLONE_* ARG) only invalidates that
# layer and everything after it — all earlier packages stay cached.
#
# Layer order (slowest/most-stable first → fastest/most-volatile last):
#   1  base + system deps          (almost never changes)
#   2  Isaac ROS apt packages      (changes on ROS release day only)
#   2b Gazebo / ros_gz sim deps    (for src/sim, changes rarely)
#   3  realsense configs patch     (changes rarely)
#   4  sllidar_ros2                (lidar driver, stable)
#   5  ros2_dji_serial             (serial/DJI driver, occasional)
#   6  Realsense_ROI_Depth_Rect.   (depth utils, occasional)
#   7  rf2o_laser_odometry         (lidar odometry for EKF fusion, occasional)
#   8  sentry_localization         (SLAM/AMCL/EKF deps + clone+build, actively developed)
#   9  sentry_pkg                  (hw interface/description deps + clone+build, actively developed)
#   10 realsense-yolov8-nitros-bridge  (our package, actively developed)
#   11 udev rules + entrypoint     (depends on sllidar being installed)
#
# Usage
# -----
#   docker build -f Dockerfile.thornbots -t thornbots:latest .
#
#   # Force re-clone + rebuild of a single package without touching others:
#   docker build --build-arg RECLONE_BRIDGE=2 -f Dockerfile.thornbots -t thornbots:latest .
##############################################################################

ARG BASE_IMAGE=nvcr.io/nvidia/isaac/ros:humble-3.2
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]
RUN sed -i 's/adduser \${USERNAME} sudo  >\/dev\/null/adduser \${USERNAME} sudo  >\/dev\/null\ngroupadd -f dialout >\/dev\/null\nadduser \${USERNAME} dialout >\/dev\/null/' \
    /usr/local/bin/scripts/workspace-entrypoint.sh

# ─── Git URL overrides (useful for forks / private mirrors) ───────────────
ARG SLLIDAR_GIT_URL=https://github.com/Thornbots/sllidar_ros2.git
ARG RF2O_GIT_URL=https://github.com/Thornbots/rf2o_laser_odometry.git
ARG RF2O_GIT_BRANCH=ros2

# ─── Shared colcon flags ──────────────────────────────────────────────────
# Limit parallelism so the Jetson/build host doesn't OOM during heavy builds.
ENV MAKEFLAGS="-j6"

# Colcon options reused in every build step below.
# --symlink-install lets us mount sources for live editing if needed.
# We skip testing to keep the layer thin.
ENV COLCON_OPTS="--symlink-install \
    --parallel-workers 3 \
    --cmake-args -DCMAKE_BUILD_TYPE=Release \
    --event-handlers console_direct+"

# Workspace root — all packages install into the same prefix so that later
# packages can find earlier ones via source /workspaces/ros2_ws/install/setup.bash
ENV ROS_WS=/workspaces/ros2_ws
ENV ROS_SETUP=/opt/ros/humble/setup.bash

##############################################################################
# LAYER 1 — System build tools
# Invalidated only when the list of apt packages changes.
##############################################################################
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    python3-colcon-common-extensions \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

##############################################################################
# LAYER 2 — Isaac ROS binary packages
# These are large; keeping them in their own layer avoids re-downloading on
# every source-code change.
##############################################################################
# this is copied from another section to avoid a docker build error
RUN curl -sS https://dl.yarnpkg.com/debian/pubkey.gpg | apt-key add - && \
    echo "deb https://dl.yarnpkg.com/debian/ stable main" > /etc/apt/sources.list.d/yarn.list && \
    apt-get update && apt-get install -y yarn && \
    corepack enable


RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-isaac-ros-yolov8 \
    ros-humble-isaac-ros-dnn-image-encoder \
    ros-humble-isaac-ros-tensor-rt \
    ros-humble-isaac-ros-examples \
    ros-humble-isaac-ros-realsense \
    ros-humble-isaac-ros-common \
    ros-humble-image-transport-plugins \
    && rm -rf /var/lib/apt/lists/*

##############################################################################
# LAYER 2b — Gazebo / ros_gz simulation packages (NOT installed by default)
#
# Needed by the `sim` package (isaac_ros-dev/src/sim, launches gz sim with
# the ARCC_Field_2026 world) — ros-humble-ros-gz pulls in Ignition Gazebo
# Fortress (libignition-gazebo6) and provides ros_gz_sim/ros_gz_bridge which
# `sim`'s package.xml exec_depends on. Not needed when running for real
# (real hardware doesn't use gz-sim), so it's commented out of the default
# build. If you want to run `sim` in a container built from this image,
# install and build it after attaching (sim is already bind-mounted at
# isaac_ros-dev/src/sim, no clone needed -- see docker/scripts/install-sim.sh):
#   sudo isaac_ros_common/docker/scripts/install-sim.sh
# robot_state_publisher/xacro are still installed unconditionally in LAYER 9
# below since sentry_pkg (real hardware or sim) needs them either way.
##############################################################################
# RUN apt-get update && apt-get install -y --no-install-recommends \
#     ros-humble-ros-gz \
#     && rm -rf /var/lib/apt/lists/*

##############################################################################
# LAYER 3 — RealSense config patches
# Small COPY; only invalidated when the yaml files change.
##############################################################################
COPY config/realsense_mono_depth_60fps.yaml \
    /opt/ros/humble/share/isaac_ros_realsense/config/realsense_mono_depth.yaml

COPY config/realsense_mono_60fps.yaml \
    /opt/ros/humble/share/isaac_ros_realsense/config/realsense_mono.yaml

##############################################################################
# LAYER 4 — sllidar_ros2 (LiDAR driver)
#
# Bump RECLONE_SLLIDAR to force a fresh clone+build without touching layers 5+.
# Because we source the workspace install at the start of each build step,
# later packages can depend on earlier ones being installed.
##############################################################################
ARG RECLONE_SLLIDAR=1
RUN mkdir -p ${ROS_WS}/src && \
    cd ${ROS_WS}/src && \
    git clone ${SLLIDAR_GIT_URL} && \
    cd ${ROS_WS} && \
    source ${ROS_SETUP} && \
    colcon build ${COLCON_OPTS} --packages-select sllidar_ros2 --parallel-workers 3

##############################################################################
# LAYER 5 — ros2_dji_serial (DJI serial bridge)
##############################################################################
ARG RECLONE_SERIAL=13
RUN cd ${ROS_WS}/src && \
    git clone https://github.com/Thornbots/ros2_dji_serial_bridge.git && \
    cd ${ROS_WS} && \
    source ${ROS_SETUP} && \
    source ${ROS_WS}/install/setup.bash && \
    colcon build ${COLCON_OPTS} --packages-select dji_serial_bridge --parallel-workers 3

##############################################################################
# LAYER 6 — Realsense_ROI_Depth_Rectifier (depth utility)
##############################################################################
ARG RECLONE_DEPTH=13
RUN cd ${ROS_WS}/src && \
    git clone https://github.com/Thornbots/Realsense_ROI_Depth_Rectifier.git && \
    cd ${ROS_WS} && \
    source ${ROS_SETUP} && \
    source ${ROS_WS}/install/setup.bash && \
    colcon build ${COLCON_OPTS} --packages-select roi_depth_query --parallel-workers 3

##############################################################################
# LAYER 7 — rf2o_laser_odometry (lidar odometry, feeds the EKF in LAYER 8)
#
# Not in apt for Humble. Now a Thornbots fork (like sllidar_ros2 in LAYER 4)
# rather than vendored straight from upstream: upstream only ever queries the
# laser->base_frame_id TF once, on its first scan, and caches it for the
# node's lifetime -- it assumes a rigidly-fixed sensor mount. Our lidar is
# head-mounted and pans independently of the base (see sentry_pkg's URDF),
# so that cached transform goes stale the moment the head moves. The fork
# re-queries it every scan instead. Publishes /scan_odom to fuse with wheel
# odometry (/odom) in sentry_localization's EKF -- wheel odometry alone
# drifts on the ARCC field's "Bumpy Road" zone.
##############################################################################
ARG RECLONE_RF2O=2
RUN cd ${ROS_WS}/src && \
    git clone --branch ${RF2O_GIT_BRANCH} ${RF2O_GIT_URL} && \
    cd ${ROS_WS} && \
    source ${ROS_SETUP} && \
    source ${ROS_WS}/install/setup.bash && \
    colcon build ${COLCON_OPTS} --packages-select rf2o_laser_odometry --parallel-workers 3

##############################################################################
# LAYER 8 — sentry_localization (SLAM/AMCL/EKF)
#
# Split out of sentry_pkg: turns /odom + /scan into odom->root. colcon build
# skips exec_depends, so its package.xml deps are apt-installed here.
# rf2o_laser_odometry is built from source in layer 7.
##############################################################################
ARG RECLONE_LOCALIZATION=1
# ros-humble-diagnostic-updater is pinned to >= 4.0.7 deliberately: 4.0.6 is
# a header-only build that ships no libdiagnostic_updater.so at all, so any
# node linking it dies at startup with
#   "error while loading shared libraries: libdiagnostic_updater.so"
# (exit code 127). It's a transitive dep of both robot_localization
# (ekf_node) and nav2_lifecycle_manager, so a bad version silently takes out
# the ekf and amcl localization_modes while slam keeps working -- which
# reads like a localization regression rather than a packaging problem. Bit
# this project twice (2026-07-20, 2026-07-25); see SESSION_NOTES.md.
# The constraint goes through `apt-get satisfy`, not `apt-get install`:
# "pkg (>= ver)" is Debian control-file dependency syntax, and apt-get
# install does not accept it -- it treats the whole string as a package
# name and fails with "Unable to locate package ros-humble-diagnostic-
# updater (>". apt-get satisfy is the subcommand that parses it.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-laser-filters \
    ros-humble-slam-toolbox \
    ros-humble-robot-localization \
    ros-humble-nav2-amcl \
    ros-humble-nav2-map-server \
    ros-humble-nav2-lifecycle-manager \
    && apt-get satisfy -y --no-install-recommends \
    "ros-humble-diagnostic-updater (>= 4.0.7)" \
    && rm -rf /var/lib/apt/lists/*
RUN cd ${ROS_WS}/src && \
    git clone https://github.com/Thornbots/sentry_localization.git && \
    cd ${ROS_WS} && \
    source ${ROS_SETUP} && \
    source ${ROS_WS}/install/setup.bash && \
    colcon build ${COLCON_OPTS} --packages-select sentry_localization --parallel-workers 3

##############################################################################
# LAYER 9 — sentry_pkg (hardware interface + robot description)
#
# package.xml deps apt-installed here (colcon skips exec_depends). sllidar_ros2
# built in layer 4; sentry_localization (exec_depend) built in layer 8. Gazebo
# (ros_gz_*) sim deps are NOT installed here -- real hardware never launches
# gz-sim; see LAYER 2b for `sim`.
##############################################################################
ARG RECLONE_SENTRY=11
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-joint-state-publisher \
    ros-humble-joint-state-publisher-gui \
    ros-humble-robot-state-publisher \
    ros-humble-xacro \
    ros-humble-rviz2 \
    && rm -rf /var/lib/apt/lists/*
RUN cd ${ROS_WS}/src && \
    git clone https://github.com/Thornbots/sentry_pkg.git && \
    cd ${ROS_WS} && \
    source ${ROS_SETUP} && \
    source ${ROS_WS}/install/setup.bash && \
    colcon build ${COLCON_OPTS} --packages-select sentry_pkg --parallel-workers 3

##############################################################################
# LAYER 10 — realsense-yolov8-nitros-bridge
#
# This is last because it changes most often; bumping RECLONE_BRIDGE only
# invalidates this layer and layer 11 below.
##############################################################################
ARG RECLONE_BRIDGE=36
RUN cd ${ROS_WS}/src && \
    git clone https://github.com/Thornbots/realsense-yolov8-nitros-bridge.git && \
    cd ${ROS_WS} && \
    source ${ROS_SETUP} && \
    source ${ROS_WS}/install/setup.bash && \
    colcon build ${COLCON_OPTS} --packages-select realsense_yolov8_nitros_bridge --parallel-workers 3

##############################################################################
# LAYER 11 — Environment + udev rules
#
# Must come after sllidar (layer 4) because it sources its script.
# Stays cached unless any earlier layer was invalidated.
##############################################################################
ARG ROS_DOMAIN_ID=42
RUN echo "export ROS_DOMAIN_ID=${ROS_DOMAIN_ID}" >> /etc/bash.bashrc && \
    echo "export FASTRTPS_DEFAULT_PROFILES_FILE=/etc/fastdds/profile.xml"  >> /etc/bash.bashrc && \
    echo "export RMW_IMPLEMENTATION=rmw_fastrtps_cpp"  >> /etc/bash.bashrc
RUN echo "source ${ROS_SETUP}" >> /etc/bash.bashrc && \
    echo "source ${ROS_WS}/install/setup.bash" >> /etc/bash.bashrc
# Sends connections to devices over usbc cable
COPY fastdds_cable.xml /etc/fastdds/profile.xml
# sllidar udev rules — run from its source tree which was cloned in layer 4
# shouldn't be necessary anymore because we have dialout perms
#RUN source ${ROS_WS}/src/sllidar_ros2/scripts/create_udev_rules.sh

WORKDIR ${ROS_WS}
CMD ["/bin/bash"]
